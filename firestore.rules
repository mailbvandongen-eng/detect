rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read, create, update, delete: if signedIn()
        && request.auth.uid == userId;

      match /{document=**} {
        allow read, create, update, delete: if signedIn()
          && request.auth.uid == userId;
      }
    }

    match /sharedImportedLayers/{shareId} {
      function isOwner() {
        return signedIn() && resource.data.ownerUid == request.auth.uid;
      }

      function isRecipient() {
        return signedIn()
          && request.auth.token.email != null
          && resource.data.recipientEmail == request.auth.token.email;
      }

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      allow read: if isOwner() || isRecipient();

      allow update: if isOwner()
        || (
          isRecipient()
          && resource.data.permission == 'edit'
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.recipientEmail == resource.data.recipientEmail
          && request.resource.data.permission == resource.data.permission
          && request.resource.data.layerId == resource.data.layerId
        );

      allow delete: if isOwner();

      match /chunks/{chunkId} {
        function parentShare() {
          return get(/databases/$(database)/documents/sharedImportedLayers/$(shareId)).data;
        }

        function chunkOwner() {
          return signedIn() && parentShare().ownerUid == request.auth.uid;
        }

        function chunkRecipient() {
          return signedIn()
            && request.auth.token.email != null
            && parentShare().recipientEmail == request.auth.token.email;
        }

        allow read: if chunkOwner() || chunkRecipient();
        allow create, update, delete: if chunkOwner()
          || (chunkRecipient() && parentShare().permission == 'edit');
      }
    }
  }
}
