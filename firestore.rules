rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read, create, update, delete: if signedIn()
        && request.auth.uid == userId;
    }

    match /sharedImportedLayers/{shareId} {
      function isOwner() {
        return signedIn() && resource.data.ownerUid == request.auth.uid;
      }

      function isRecipient() {
        return signedIn()
          && request.auth.token.email != null
          && resource.data.recipientEmail == request.auth.token.email;
      }

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      allow read: if isOwner() || isRecipient();

      allow update: if isOwner()
        || (
          isRecipient()
          && resource.data.permission == 'edit'
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.recipientEmail == resource.data.recipientEmail
          && request.resource.data.permission == resource.data.permission
          && request.resource.data.layerHash == resource.data.layerHash
        );

      allow delete: if isOwner();
    }

    match /sharedImportedLayers/{shareId}/chunks/{chunkId} {
      function parentShare() {
        return get(/databases/$(database)/documents/sharedImportedLayers/$(shareId)).data;
      }

      function parentOwner() {
        return signedIn() && parentShare().ownerUid == request.auth.uid;
      }

      function parentRecipient() {
        return signedIn()
          && request.auth.token.email != null
          && parentShare().recipientEmail == request.auth.token.email;
      }

      allow read: if parentOwner() || parentRecipient();
      allow create, update, delete: if parentOwner();
    }
    // Buddy-lagen: gedeelde puntlagen voor zoekmaatjes.
    match /buddyLayers/{layerId} {
      function buddyEmail() {
        return signedIn() && request.auth.token.email != null
          ? request.auth.token.email
          : '';
      }

      function buddyMember() {
        return signedIn()
          && request.auth.token.email != null
          && resource.data.memberEmails.hasAny([request.auth.token.email]);
      }

      function buddyOwner() {
        return signedIn() && resource.data.ownerUid == request.auth.uid;
      }

      allow create: if signedIn()
        && request.auth.token.email != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.memberEmails.hasAny([request.auth.token.email]);

      allow read: if buddyMember();
      allow update: if buddyOwner()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.ownerEmail == resource.data.ownerEmail;

      allow delete: if buddyOwner();
    }

    match /buddyLayers/{layerId}/points/{pointId} {
      function buddyParent() {
        return get(/databases/$(database)/documents/buddyLayers/$(layerId)).data;
      }

      function buddyPointMember() {
        return signedIn()
          && request.auth.token.email != null
          && buddyParent().memberEmails.hasAny([request.auth.token.email]);
      }

      function buddyPointEditor() {
        return signedIn()
          && (
            buddyParent().ownerUid == request.auth.uid
            || (
              request.auth.token.email != null
              && buddyParent().editEmails.hasAny([request.auth.token.email])
            )
          );
      }

      allow read: if buddyPointMember();
      allow create, update, delete: if buddyPointEditor();
    }

  }
}
