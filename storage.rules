rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // A download token is shared only through an authorized point document.
    // Other accounts cannot list objects or obtain tokens via the Storage SDK.
    match /users/{uid}/layers/{layer}/points/{point}/{photo} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg'
        && photo.matches('photo_[a-zA-Z0-9_-]+[.]jpg');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
